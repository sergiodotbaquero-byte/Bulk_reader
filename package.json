{
  "name": "mtg-bulk-scanner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PWA para escanear cartas de Magic: The Gathering con la cámara y llevar inventario de bulk",
  "scripts": {
    "predev": "node scripts/copy-tesseract.mjs",
    "dev": "vite --host",
    "prebuild": "node scripts/copy-tesseract.mjs",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "preview": "vite preview --host --port 4173",
    "preview:https": "vite preview --host --port 4173 --mode https",
    "icons": "python scripts/make_icons.py",
    "names": "node scripts/build-names.mjs es pt && node scripts/fix-ambiguous-names.mjs es pt",
    "names:fix": "node scripts/fix-ambiguous-names.mjs es pt"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.8",
    "vite-plugin-pwa": "^1.3.0"
  }
}
